---
import '../styles/global.scss';
import Stalker from '../components/Stalker.tsx';
import Header from '../components/Header.tsx';

const isHome = Astro.url.pathname === "/";
const isWork = /^\/works\/.+/.test(Astro.url.pathname);
const title = (Astro.props.title as string) || 'Pixel';
const description = (Astro.props.description as string) || 'Pixel | Motion Graphic Designer';
const robots = (Astro.props.robots as string) || 'index,follow';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja" class="is-initial-loading">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />

        <!-- Preconnect to critical origins -->
        <link rel="preconnect" href="https://ap-northeast-1.graphassets.com" crossorigin />
        <link rel="preconnect" href="https://use.typekit.net" crossorigin />
        <link rel="preconnect" href="https://p.typekit.net" crossorigin />
        <link rel="preconnect" href="https://unpkg.com" crossorigin />

        <!-- Defer Adobe Typekit CSS to avoid render-blocking -->
        <link
            rel="stylesheet"
            href="https://use.typekit.net/wvf5bje.css"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link rel="stylesheet" href="https://use.typekit.net/wvf5bje.css" />
        </noscript>

        <!-- Google Fonts: preconnect and defer stylesheet with swap -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonical.toString()} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/logo.svg" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@pmgwork" />
        {Astro.slots.has('head') && <slot name="head" />}
    </head>
    <body class:list={{ "is-top": isHome, "is-work": isWork }}>
        <Stalker client:idle />
        <Header client:idle />
        <div id="site-background"></div>
        <div id="swup" class="transition-fade">
            <div id="smooth-content">
                <slot />
            </div>
        </div>
        <script>
            import swup from '../lib/utils/swup';
            import { ScrollSmoother } from '../lib/utils/gsap';
            import { animateShared, animateAbout, animateWork, animateWorks } from '../lib/animations/';

            // 初期ロード時のフェードイン制御
            document.documentElement.classList.remove('is-initial-loading');

            // ページ遷移時にページビューイベントを発火させる
            window.dispatchEvent(new CustomEvent('swup:page:view'));

            // 慣性スクロールの初期化
            function initSmoother() {
                return ScrollSmoother.create({
                    wrapper: '#swup',
                    content: '#smooth-content',
                    smooth: 0.6,
                });
            }

            // アニメーションの初期化
            function initAnimations() {
                const currentPath = window.location.pathname;

                // 全ページ共通
                animateShared();

                // ページ固有のアニメーション
                if (currentPath === '/works' || currentPath === '/works/') animateWorks();
                if (currentPath === '/about' || currentPath === '/about/') animateAbout();
                if (currentPath.startsWith('/works/') && currentPath !== '/works/') animateWork();
            }

            // クラスを更新
            function updateClass(pathname: string) {
                const isWorkPath = /^\/works\/.+/.test(pathname);
                document.body.classList.toggle('is-work', isWorkPath);
            }

            // 初期化
            requestAnimationFrame(() => {
                initSmoother();
                initAnimations();
                updateClass(window.location.pathname);
            });

            // 遷移開始時に次ページに合わせて更新
            swup.hooks.on('visit:start', (visit) => {
                const nextUrl = visit?.to?.url ? new URL(visit.to.url, location.origin) : null;
                const nextPath = nextUrl ? nextUrl.pathname : '';
                updateClass(nextPath);
            });

            // 差し替え直後に初期化
            swup.hooks.on('content:replace', () => {
                initSmoother()?.scrollTo(0, false);
                initAnimations();
            });
        </script>
        <noscript>
            <style>
                html.is-initial-loading .transition-fade { opacity: 1 !important; filter: none !important; }
                html.is-initial-loading header { opacity: 1 !important; filter: none !important; }
            </style>
        </noscript>
    </body>
</html>
